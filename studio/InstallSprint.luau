game.StarterPlayer.StarterPlayerScripts.FistsClient.Source="local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal ContentProvider = game:GetService(\"ContentProvider\")\nlocal SoundService = game:GetService(\"SoundService\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal Debris = game:GetService(\"Debris\")\n\nlocal player = Players.LocalPlayer\nlocal camera = workspace.CurrentCamera\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"FistsConfig\"))\nlocal Remotes = ReplicatedStorage:WaitForChild(\"Remotes\")\nlocal PunchRemote = Remotes:WaitForChild(\"Punch\")\nlocal PunchHitRemote = Remotes:WaitForChild(\"PunchHit\")\n\nlocal BASE_FOV = 75\nlocal SLEEVE_COLOR = Color3.fromRGB(45, 45, 55)\n\n-- Phases de l'animation d'un coup (secondes)\nlocal WINDUP, STRIKE, RECOVER = 0.09, 0.08, 0.30\n\n------------------------------------------------------------------\n-- SONS\n------------------------------------------------------------------\nlocal function playSound(ids, volume, speed)\n\tlocal s = Instance.new(\"Sound\")\n\ts.SoundId = \"rbxassetid://\" .. ids[math.random(#ids)]\n\ts.Volume = volume\n\ts.PlaybackSpeed = (speed or 1) * (0.93 + math.random() * 0.14)\n\ts.Parent = SoundService\n\ts:Play()\n\ts.Ended:Once(function() s:Destroy() end)\n\tDebris:AddItem(s, 4)\nend\n\ntask.spawn(function() -- préchargement pour éviter le silence au 1er coup\n\tlocal toLoad = {}\n\tfor _, list in ipairs({ Config.SwingSounds, Config.HitSounds, Config.HeavyHitSounds }) do\n\t\tfor _, id in ipairs(list) do\n\t\t\tlocal s = Instance.new(\"Sound\")\n\t\t\ts.SoundId = \"rbxassetid://\" .. id\n\t\t\ttable.insert(toLoad, s)\n\t\tend\n\tend\n\tpcall(function() ContentProvider:PreloadAsync(toLoad) end)\n\tfor _, s in ipairs(toLoad) do s:Destroy() end\nend)\n\n------------------------------------------------------------------\n-- VIEWMODEL (bras + poings devant la caméra)\n------------------------------------------------------------------\nlocal function getHumanoid()\n\tlocal char = player.Character\n\treturn char and char:FindFirstChildOfClass(\"Humanoid\")\nend\n\nlocal function getSkinColor()\n\tlocal hum = getHumanoid()\n\tif hum then\n\t\tlocal ok, desc = pcall(function() return hum:GetAppliedDescription() end)\n\t\tif ok and desc then return desc.RightArmColor end\n\tend\n\treturn Color3.fromRGB(234, 184, 146)\nend\n\nlocal function makePart(name, size, color, shape, parent)\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = name\n\tp.Size = size\n\tp.Color = color\n\tp.Material = Enum.Material.SmoothPlastic\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Massless = true\n\tif shape then p.Shape = shape end\n\tp.Parent = parent\n\treturn p\nend\n\nlocal viewmodel = Instance.new(\"Folder\")\nviewmodel.Name = \"FistsViewmodel\"\n\nlocal function buildSide(sign, skin)\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name = sign < 0 and \"LeftArm\" or \"RightArm\"\n\tmodel.Parent = viewmodel\n\treturn {\n\t\tsign = sign,\n\t\tstart = -math.huge,\n\t\tscale = 1,\n\t\t-- position de repos (bas gauche / bas droite de l'écran), légèrement tournée vers le centre\n\t\tbase = CFrame.new(sign * 0.9, -0.85, -2.0) * CFrame.Angles(math.rad(6), math.rad(sign * 8), 0),\n\t\tparts = {\n\t\t\t{ part = makePart(\"Fist\", Vector3.one * 0.72, skin, Enum.PartType.Ball, model), rel = CFrame.new() },\n\t\t\t{ part = makePart(\"Forearm\", Vector3.new(0.5, 0.5, 1.3), skin, nil, model), rel = CFrame.new(0, 0, 0.85) },\n\t\t\t{ part = makePart(\"Sleeve\", Vector3.new(0.68, 0.68, 1.4), SLEEVE_COLOR, nil, model), rel = CFrame.new(0, 0, 2.2) },\n\t\t},\n\t}\nend\n\nlocal skin = getSkinColor()\nlocal sides = {\n\tLeft = buildSide(-1, skin),\n\tRight = buildSide(1, skin),\n}\n\n------------------------------------------------------------------\n-- VISEUR\n------------------------------------------------------------------\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"Crosshair\"\ngui.IgnoreGuiInset = true\ngui.ResetOnSpawn = false\ngui.Parent = player:WaitForChild(\"PlayerGui\")\n\nlocal dot = Instance.new(\"Frame\")\ndot.AnchorPoint = Vector2.new(0.5, 0.5)\ndot.Position = UDim2.fromScale(0.5, 0.5)\ndot.Size = UDim2.fromOffset(6, 6)\ndot.BackgroundColor3 = Color3.new(1, 1, 1)\ndot.BorderSizePixel = 0\ndot.Parent = gui\nInstance.new(\"UICorner\", dot).CornerRadius = UDim.new(1, 0)\nlocal stroke = Instance.new(\"UIStroke\", dot)\nstroke.Thickness = 1.5\nstroke.Color = Color3.new(0, 0, 0)\nstroke.Transparency = 0.3\n\nlocal function flashCrosshair(heavy)\n\tlocal big = heavy and 16 or 11\n\tdot.BackgroundColor3 = Color3.fromRGB(255, 70, 70)\n\tdot.Size = UDim2.fromOffset(big, big)\n\tTweenService:Create(dot, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {\n\t\tBackgroundColor3 = Color3.new(1, 1, 1),\n\t\tSize = UDim2.fromOffset(6, 6),\n\t}):Play()\nend\n\n------------------------------------------------------------------\n-- ANIMATION D'UN COUP\n-- renvoie p : -0.35 (recul) -> 1 (coup tendu) -> 0 (repos)\n------------------------------------------------------------------\nlocal function punchAlpha(t)\n\tif t < WINDUP then\n\t\tlocal a = t / WINDUP\n\t\treturn -0.35 * (1 - (1 - a) ^ 2)\n\telseif t < WINDUP + STRIKE then\n\t\tlocal a = (t - WINDUP) / STRIKE\n\t\treturn -0.35 + 1.35 * (1 - (1 - a) ^ 3)\n\telseif t < WINDUP + STRIKE + RECOVER then\n\t\tlocal a = (t - WINDUP - STRIKE) / RECOVER\n\t\treturn 1 - a * a * (3 - 2 * a)\n\tend\n\treturn 0\nend\n\n-- Camera shake + FOV kick\nlocal shakeStart, shakeDur, shakeAmp = -math.huge, 0.2, 0\nlocal function shake(amp)\n\tshakeStart = os.clock()\n\tshakeAmp = amp\nend\n\nlocal fovImpulse = 0\nlocal function fovKick(amount)\n fovImpulse = amount\nend\n\ncamera.FieldOfView = BASE_FOV\n\n------------------------------------------------------------------\n-- BOUCLE DE RENDU\n------------------------------------------------------------------\nlocal sway = Vector3.zero\nlocal lastCF = camera.CFrame\nlocal bobT, moveAlpha = 0, 0\nlocal sprintAlpha = 0\n\nRunService:BindToRenderStep(\"FistsViewmodel\", Enum.RenderPriority.Camera.Value + 1, function(dt)\n\tcamera = workspace.CurrentCamera\n\tlocal hum = getHumanoid()\n\tlocal alive = hum ~= nil and hum.Health > 0\n\n\tlocal wantedParent = alive and camera or nil\n\tif viewmodel.Parent ~= wantedParent then\n\t\tviewmodel.Parent = wantedParent\n\tend\n\tif not alive then\n  sprintAlpha = 0\n  fovImpulse = 0\n  camera.FieldOfView = BASE_FOV\n  return\n end\n local running = player.Character:GetAttribute(\"Sprinting\") == true\n sprintAlpha += ((running and 1 or 0) - sprintAlpha) * math.clamp(dt * 9, 0, 1)\n fovImpulse *= math.exp(-dt * 12)\n local targetFov = BASE_FOV + 7 * sprintAlpha - fovImpulse\n camera.FieldOfView += (targetFov - camera.FieldOfView) * (1 - math.exp(-dt * 12))\n\n\t-- Sway : les bras \"traînent\" quand on tourne la caméra\n\tlocal baseCF = camera.CFrame\n\tlocal rx, ry = lastCF:ToObjectSpace(baseCF):ToEulerAnglesYXZ()\n\tlastCF = baseCF\n\tlocal goal = Vector3.new(math.clamp(ry * 5, -0.3, 0.3), math.clamp(-rx * 5, -0.3, 0.3), 0)\n\tsway = sway:Lerp(goal, math.clamp(dt * 10, 0, 1))\n\n\t-- Camera shake (appliqué après le calcul du sway)\n\tlocal st = os.clock() - shakeStart\n\tif st < shakeDur then\n\t\tlocal k = (1 - st / shakeDur) ^ 2 * shakeAmp\n\t\tcamera.CFrame = baseCF * CFrame.Angles(\n\t\t\tmath.rad((math.random() - 0.5) * 2 * k),\n\t\t\tmath.rad((math.random() - 0.5) * 2 * k),\n\t\t\tmath.rad((math.random() - 0.5) * 2 * k)\n\t\t)\n\tend\n\n\t-- Balancement de marche + respiration\n\tlocal moving = (hum.MoveDirection.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air) and 1 or 0\n\tmoveAlpha += (moving - moveAlpha) * math.clamp(dt * 8, 0, 1)\n\tbobT += dt * (9 + 5 * sprintAlpha) * moveAlpha\n\tlocal bob = Vector3.new(math.sin(bobT) * 0.045, -math.abs(math.sin(bobT)) * 0.05, 0) * moveAlpha\n\tlocal idle = Vector3.new(0, math.sin(os.clock() * 1.6) * 0.008, 0)\n\tlocal offset = CFrame.new(sway + bob + idle)\n\n\tlocal camCF = camera.CFrame\n\tlocal now = os.clock()\n\tfor _, side in pairs(sides) do\n\t\tlocal p = punchAlpha(now - side.start) * side.scale\n\t\tlocal anim = CFrame.new(-side.sign * 0.55 * p, 0.38 * p, -1.25 * p)\n\t\t\t* CFrame.Angles(math.rad(6 * p), math.rad(side.sign * 10 * p), math.rad(-side.sign * 8 * p))\n\t\tlocal notPunching = math.clamp(1 - math.abs(p) * 3, 0, 1)\n  local run = sprintAlpha * notPunching\n  local stride = math.sin(bobT + (side.sign < 0 and math.pi or 0))\n  local runPose = CFrame.new(-side.sign * 0.1 * run, (-0.2 + stride * 0.12) * run, stride * 0.16 * run)\n   * CFrame.Angles(math.rad((-18 + stride * 12) * run), 0, math.rad(side.sign * 14 * run))\n  local root = camCF * offset * side.base * runPose * anim\n\t\tfor _, item in ipairs(side.parts) do\n\t\t\titem.part.CFrame = root * item.rel\n\t\tend\n\tend\nend)\n\n------------------------------------------------------------------\n-- ACTION : FRAPPER\n------------------------------------------------------------------\nlocal lastPunch, lastComboTime, comboIndex = 0, 0, 0\nlocal nextHand = \"Right\"\nlocal held = false\n\nlocal function doPunch()\n\tlocal hum = getHumanoid()\n\tif not hum or hum.Health <= 0 then return end\n\n\tlocal now = os.clock()\n\tif now - lastPunch < Config.Cooldown then return end\n\tlastPunch = now\n\n\tif now - lastComboTime > Config.ComboWindow then comboIndex = 0 end\n\tcomboIndex = comboIndex % Config.ComboLength + 1\n\tlastComboTime = now\n\tlocal heavy = comboIndex == Config.ComboLength\n\n\t-- main qui frappe (alternance droite / gauche)\n\tlocal side = sides[nextHand]\n\tnextHand = (nextHand == \"Right\") and \"Left\" or \"Right\"\n\tside.start = now\n\tside.scale = heavy and 1.3 or 1\n\n\t-- SFX du coup dans l'air\n\tplaySound(Config.SwingSounds, heavy and 0.9 or 0.6, heavy and 0.85 or 1)\n\n\t-- Le coup est envoyé au serveur au moment où le poing arrive au bout\n\ttask.delay(WINDUP + STRIKE, function()\n\t\tlocal h = getHumanoid()\n\t\tif not h or h.Health <= 0 then return end\n\t\tfovKick(heavy and 3 or 1.5)\n\t\tPunchRemote:FireServer(workspace.CurrentCamera.CFrame.LookVector)\n\tend)\nend\n\nContextActionService:BindAction(\"FistsPunch\", function(_, state)\n\tif state == Enum.UserInputState.Begin then\n\t\theld = true\n\t\tdoPunch()\n\telseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then\n\t\theld = false\n\tend\n\treturn Enum.ContextActionResult.Sink\nend, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)\nContextActionService:SetTitle(\"FistsPunch\", \"👊\")\nContextActionService:SetPosition(\"FistsPunch\", UDim2.new(1, -100, 1, -160))\n\n-- Maintenir le clic = enchaîner les coups\nRunService.Heartbeat:Connect(function()\n\tif held then doPunch() end\nend)\n\n-- Confirmation d'impact venant du serveur : shake + viseur rouge\nPunchHitRemote.OnClientEvent:Connect(function(heavy, killed)\n\tshake(heavy and 1.1 or 0.55)\n\tflashCrosshair(heavy)\nend)\n"
do local parent=game.ReplicatedStorage assert(not parent:FindFirstChild("SprintConfig"),"Already installed") local s=Instance.new("ModuleScript") s.Name="SprintConfig" s.Source="return {\n MaxStamina=100,\n SprintSpeed=26,\n DrainPerSecond=20,\n RegenPerSecond=18,\n RegenDelay=1.25,\n RecoveryThreshold=25,\n ReplicationInterval=0.1,\n R15Animation=\"rbxassetid://507767714\",\n R6Animation=\"rbxassetid://180426354\",\n Footsteps=\"rbxasset://sounds/action_footsteps_plastic.mp3\",\n Breathing=\"rbxassetid://101395573137763\",\n}\n" s.Parent=parent end
do local parent=game.ServerScriptService assert(not parent:FindFirstChild("SprintState"),"Already installed") local s=Instance.new("ModuleScript") s.Name="SprintState" s.Source="-- Pure stamina rules; the server supplies movement and elapsed time.\nlocal State={}\nfunction State.new(config)\n return {stamina=config.MaxStamina,wants=false,exhausted=false,sprinting=false,rest=0}\nend\nfunction State.step(s,config,dt,moving,alive)\n if not alive then\n  s.wants=false s.sprinting=false return\n end\n if s.exhausted and not s.wants and s.stamina>=config.RecoveryThreshold then s.exhausted=false end\n s.sprinting=s.wants and moving and not s.exhausted and s.stamina>0\n if s.sprinting then\n  s.stamina=math.max(0,s.stamina-config.DrainPerSecond*dt)\n  s.rest=0\n  if s.stamina<=0 then s.exhausted=true s.sprinting=false end\n else\n  local previousRest=s.rest\n  s.rest+=dt\n  local regenTime=math.max(0,s.rest-math.max(previousRest,config.RegenDelay))\n  s.stamina=math.min(config.MaxStamina,s.stamina+config.RegenPerSecond*regenTime)\n end\nend\nreturn State\n" s.Parent=parent end
do local parent=game.ServerScriptService assert(not parent:FindFirstChild("SprintServer"),"Already installed") local s=Instance.new("Script") s.Name="SprintServer" s.Source="local Players=game:GetService(\"Players\")\nlocal RunService=game:GetService(\"RunService\")\nlocal ReplicatedStorage=game:GetService(\"ReplicatedStorage\")\nlocal Config=require(ReplicatedStorage:WaitForChild(\"SprintConfig\"))\nlocal State=require(script.Parent:WaitForChild(\"SprintState\"))\nlocal remote=ReplicatedStorage:WaitForChild(\"Remotes\"):WaitForChild(\"Sprint\")\nlocal states={}\nlocal function publish(character,s)\n character:SetAttribute(\"Stamina\",math.floor(s.stamina*10+0.5)/10)\n character:SetAttribute(\"MaxStamina\",Config.MaxStamina)\n character:SetAttribute(\"Sprinting\",s.sprinting)\n character:SetAttribute(\"SprintExhausted\",s.exhausted)\nend\nlocal function bind(player,character)\n local s=State.new(Config)\n s.character=character s.lastRequest=-math.huge\n states[player]=s publish(character,s)\n local humanoid=character:WaitForChild(\"Humanoid\",10)\n if not humanoid or states[player]~=s then return end\n s.humanoid=humanoid s.baseSpeed=humanoid.WalkSpeed\nend\nlocal function setup(player)\n player.CharacterAdded:Connect(function(character) bind(player,character) end)\n if player.Character then task.spawn(bind,player,player.Character) end\nend\nPlayers.PlayerAdded:Connect(setup)\nPlayers.PlayerRemoving:Connect(function(player) states[player]=nil end)\nfor _,player in Players:GetPlayers() do setup(player) end\nremote.OnServerEvent:Connect(function(player,wants)\n if typeof(wants)~=\"boolean\" then return end\n local s=states[player]\n if not s or not s.humanoid or s.humanoid.Health<=0 then return end\n local now=os.clock()\n if wants and now-s.lastRequest<0.05 then return end\n s.lastRequest=now s.wants=wants\nend)\nlocal elapsed=0\nRunService.Heartbeat:Connect(function(dt)\n elapsed+=dt\n if elapsed<Config.ReplicationInterval then return end\n local step=elapsed elapsed=0\n for player,s in states do\n  local h=s.humanoid\n  local character=s.character\n  if not h or character~=player.Character or not character.Parent then continue end\n  local root=character:FindFirstChild(\"HumanoidRootPart\")\n  local alive=h.Health>0 and not h.Sit and not h.PlatformStand\n  local velocity=root and root.AssemblyLinearVelocity or Vector3.zero\n  local moving=Vector3.new(velocity.X,0,velocity.Z).Magnitude>1.5\n  local humanoidState=h:GetState()\n  local canRun=humanoidState~=Enum.HumanoidStateType.Swimming and humanoidState~=Enum.HumanoidStateType.Climbing\n  State.step(s,Config,step,moving and canRun,alive)\n  local allowed=alive and canRun and s.wants and not s.exhausted and s.stamina>0\n  h.WalkSpeed=allowed and math.max(s.baseSpeed,Config.SprintSpeed) or s.baseSpeed\n  publish(character,s)\n end\nend)\n" s.Parent=parent end
do local parent=game.StarterPlayer.StarterPlayerScripts assert(not parent:FindFirstChild("SprintClient"),"Already installed") local s=Instance.new("LocalScript") s.Name="SprintClient" s.Source="local Players=game:GetService(\"Players\")\nlocal ReplicatedStorage=game:GetService(\"ReplicatedStorage\")\nlocal ContextActionService=game:GetService(\"ContextActionService\")\nlocal UserInputService=game:GetService(\"UserInputService\")\nlocal RunService=game:GetService(\"RunService\")\nlocal ContentProvider=game:GetService(\"ContentProvider\")\nlocal player=Players.LocalPlayer\nlocal Config=require(ReplicatedStorage:WaitForChild(\"SprintConfig\"))\nlocal remote=ReplicatedStorage:WaitForChild(\"Remotes\"):WaitForChild(\"Sprint\")\nlocal hud=player:WaitForChild(\"PlayerGui\"):WaitForChild(\"SurvivalHUD\",30)\nassert(hud,\"SurvivalHUD missing from PlayerGui\")\nlocal panel=hud:WaitForChild(\"StatusPanel\",10)\nlocal card=panel:WaitForChild(\"StaminaCard\")\nlocal h,character,track,animation,footsteps,breathing\nlocal connections={}\nlocal request=false\nlocal displayStamina=Config.MaxStamina\nlocal sources={}\nlocal actionName=\"SurvivalSprint\"\nlocal function setRequest(on)\n if request==on then return end\n request=on remote:FireServer(on)\nend\nlocal function releaseAll()\n table.clear(sources) setRequest(false)\nend\nlocal function input(_,state,inputObject)\n local key=inputObject and inputObject.KeyCode or Enum.KeyCode.Unknown\n if state==Enum.UserInputState.Begin then\n  if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end\n  sources[key]=true\n elseif state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel then sources[key]=nil end\n setRequest(next(sources)~=nil)\n return Enum.ContextActionResult.Sink\nend\nContextActionService:BindAction(actionName,input,true,Enum.KeyCode.LeftShift,Enum.KeyCode.RightShift,Enum.KeyCode.ButtonL3)\nContextActionService:SetTitle(actionName,\"SPRINT\")\nContextActionService:SetPosition(actionName,UDim2.new(1,-175,1,-230))\nUserInputService.WindowFocusReleased:Connect(releaseAll)\nUserInputService.TextBoxFocused:Connect(releaseAll)\nlocal function cleanup()\n releaseAll()\n for _,c in connections do c:Disconnect() end table.clear(connections)\n if track then track:Stop(0) track:Destroy() track=nil end\n if animation then animation:Destroy() animation=nil end\n if footsteps then footsteps:Destroy() footsteps=nil end\n if breathing then breathing:Destroy() breathing=nil end\n h=nil character=nil\nend\nlocal function bind(newCharacter)\n cleanup() character=newCharacter displayStamina=Config.MaxStamina\n local humanoid=newCharacter:WaitForChild(\"Humanoid\",10)\n if not humanoid or character~=newCharacter then return end\n h=humanoid\n local root=newCharacter:WaitForChild(\"HumanoidRootPart\",10)\n local animator=humanoid:WaitForChild(\"Animator\",10)\n if character~=newCharacter or not root or not animator then return end\n animation=Instance.new(\"Animation\") animation.Name=\"SprintAnimation\"\n animation.AnimationId=humanoid.RigType==Enum.HumanoidRigType.R15 and Config.R15Animation or Config.R6Animation\n local ok,result=pcall(function() return animator:LoadAnimation(animation) end)\n if ok then track=result track.Priority=Enum.AnimationPriority.Movement track.Looped=true end\n footsteps=Instance.new(\"Sound\") footsteps.Name=\"SprintFootsteps\" footsteps.SoundId=Config.Footsteps\n footsteps.Looped=true footsteps.Volume=0 footsteps.PlaybackSpeed=1.65 footsteps.Parent=root\n breathing=Instance.new(\"Sound\") breathing.Name=\"SprintBreathing\" breathing.SoundId=Config.Breathing\n breathing.Looped=true breathing.Volume=0 breathing.Parent=workspace.CurrentCamera\n task.spawn(function() pcall(function() ContentProvider:PreloadAsync({footsteps,breathing}) end) end)\n table.insert(connections,humanoid.Died:Connect(function()\n  releaseAll() if track then track:Stop(0.12) end\n  if footsteps then footsteps:Stop() end if breathing then breathing:Stop() end\n end))\nend\nplayer.CharacterAdded:Connect(bind)\nplayer.CharacterRemoving:Connect(function(old) if character==old then cleanup() end end)\nif player.Character then task.spawn(bind,player.Character) end\nRunService.RenderStepped:Connect(function(dt)\n local alive=h and h.Health>0 and character==player.Character\n local max=alive and (character:GetAttribute(\"MaxStamina\") or Config.MaxStamina) or Config.MaxStamina\n local stamina=alive and (character:GetAttribute(\"Stamina\") or max) or 0\n local exhausted=alive and character:GetAttribute(\"SprintExhausted\") or false\n local sprinting=alive and character:GetAttribute(\"Sprinting\") or false\n local ratio=max>0 and stamina/max or 0\n displayStamina+=(stamina-displayStamina)*(1-math.exp(-dt*14))\n card.Track.Fill.Size=UDim2.fromScale(math.clamp(displayStamina/max,0,1),1)\n card.StaminaValue.Text=string.format(\"%d / %d\",math.ceil(stamina),max)\n card.Title.Text=exhausted and \"EPUISE\" or \"ENDURANCE\"\n card.Hint.Text=exhausted and \"RELACHE POUR RECUPERER\" or (UserInputService.TouchEnabled and \"MAINTENIR SPRINT\" or UserInputService.GamepadEnabled and \"L3  /  SPRINT\" or \"MAJ  /  SPRINT\")\n local color=(exhausted or ratio<0.25) and Color3.fromRGB(247,156,72) or Color3.fromRGB(91,205,197)\n card.Track.Fill.BackgroundColor3=color card.Bolt.TextColor3=color\n local running=sprinting and alive and h.MoveDirection.Magnitude>0.1 and h.FloorMaterial~=Enum.Material.Air\n if track then\n  if running then if not track.IsPlaying then track:Play(0.18) end track:AdjustSpeed(1.45)\n  elseif track.IsPlaying then track:Stop(0.18) end\n end\n if footsteps then\n  if running then\n   if not footsteps.IsPlaying then footsteps:Play() end footsteps.Volume=0.32\n  else footsteps.Volume=0 if footsteps.IsPlaying then footsteps:Stop() end end\n  -- Avoid layering the default walking loop over the sprint loop.\n  local rootPart=character and character:FindFirstChild(\"HumanoidRootPart\")\n  local normal=rootPart and rootPart:FindFirstChil